{
  "manifest_version": 3,
  "name": "Page Lens Reader — GPT + Kimi",
  "version": "0.3.0",
  "description": "Read web articles with guided questions about key ideas, source evidence, and GPT/Kimi or your own API.",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8317/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Page Lens Reader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "open-reader": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "打开 Page Lens 阅读侧栏"
    },
    "explain-selection": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "解释网页上选中的文字"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
