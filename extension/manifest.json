{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "__MSG_extName__",
  "version": "0.4.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8317/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "open-reader": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "__MSG_commandOpen__"
    },
    "explain-selection": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "__MSG_commandExplain__"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
