<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.pagelens.cliproxyapi</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/cliproxyapi</string>
    <string>-config</string>
    <string>YOUR_HOME/.cli-proxy-api/config.yaml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>YOUR_HOME/.cli-proxy-api/launch-agent.log</string>
  <key>StandardErrorPath</key>
  <string>YOUR_HOME/.cli-proxy-api/launch-agent-error.log</string>
</dict>
</plist>
